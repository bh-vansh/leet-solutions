int minimumDeletions(int* nums, int numsSize) {
    int minIndex = 0;
    int maxIndex = 0;

    // Find minimum and maximum indices
    for (int i = 1; i < numsSize; i++) {
        if (nums[i] < nums[minIndex])
            minIndex = i;

        if (nums[i] > nums[maxIndex])
            maxIndex = i;
    }

    // left = smaller index, right = larger index
    int left = minIndex < maxIndex ? minIndex : maxIndex;
    int right = minIndex > maxIndex ? minIndex : maxIndex;

    // 3 possible ways
    int fromFront = right + 1;
    int fromBack = numsSize - left;
    int fromBoth = (left + 1) + (numsSize - right);

    // Return minimum
    int ans = fromFront;

    if (fromBack < ans)
        ans = fromBack;

    if (fromBoth < ans)
        ans = fromBoth;

    return ans;
}

